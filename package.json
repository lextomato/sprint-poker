{
  "name": "planning-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Realtime agile estimation MVP with Planning Poker rooms.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @planning/shared build && pnpm -r --parallel --filter \"!@planning/shared\" dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @planning/api test:e2e",
    "db:migrate": "pnpm --filter @planning/api db:migrate",
    "db:generate": "pnpm --filter @planning/api db:generate",
    "db:seed": "pnpm --filter @planning/api db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
